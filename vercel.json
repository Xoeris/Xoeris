{
  "version": 2,
  "builds": [
    {
      "src": "sarah/sarah-ai.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/vercel-proxy/api/v1/chat/completions.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/user.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/google-login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/github-login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/verify-otp.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/auth/init.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/auth/verify.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/auth/consume.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "api/vercel-proxy/api/v1/chat/completions.js"
    },
    {
      "source": "/(webhook|set_webhook|cron|keep_alive|bot_status)",
      "destination": "sarah/sarah-ai.py"
    },
    {
      "source": "/api/search",
      "destination": "api/search.js"
    },
    {
      "source": "/api/database1/user/:username",
      "destination": "api/database1/user.js"
    },
    {
      "source": "/api/database1/login",
      "destination": "api/database1/login.js"
    },
    {
      "source": "/api/database1/google-login",
      "destination": "api/database1/google-login.js"
    },
    {
      "source": "/api/database1/github-login",
      "destination": "api/database1/github-login.js"
    },
    {
      "source": "/api/database1/verify-otp",
      "destination": "api/database1/verify-otp.js"
    },
    {
      "source": "/api/auth/init",
      "destination": "api/auth/init.js"
    },
    {
      "source": "/api/auth/verify",
      "destination": "api/auth/verify.js"
    },
    {
      "source": "/api/auth/consume",
      "destination": "api/auth/consume.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
