{
  "version": 2,
  "builds": [
    {
      "src": "sarah/sarah-ai.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/vercel-proxy/api/v1/chat/completions.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/user.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/google-login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/sync.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 15
      }
    },
    {
      "src": "api/database1/subscribe.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 25
      }
    },
    {
      "src": "api/database1/github-login.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },

    {
      "src": "api/auth/flow.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/database1/admin/admin-router.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "redirects": [
    {
      "source": "/xalme",
      "destination": "https://xalme.xoeris.com/",
      "permanent": false
    },
    {
      "source": "/xalme/:path*",
      "destination": "https://xalme.xoeris.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(xoeris_logo_.*|favicon\\..*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|otf|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "api/vercel-proxy/api/v1/chat/completions.js"
    },
    {
      "source": "/(webhook|set_webhook|cron|keep_alive|bot_status)",
      "destination": "sarah/sarah-ai.py"
    },
    {
      "source": "/api/search",
      "destination": "api/search.js"
    },
    {
      "source": "/api/database1/admin/(.*)",
      "destination": "api/database1/admin/admin-router.js"
    },
    {
      "source": "/api/database1/admin",
      "destination": "api/database1/admin/admin-router.js"
    },
    {
      "source": "/api/database1/user/:username",
      "destination": "api/database1/user.js"
    },
    {
      "source": "/api/database1/login",
      "destination": "api/database1/login.js"
    },
    {
      "source": "/api/database1/google-login",
      "destination": "api/database1/google-login.js"
    },
    {
      "source": "/api/database1/google-config",
      "destination": "api/database1/google-login.js"
    },
    {
      "source": "/api/database1/github-config",
      "destination": "api/database1/github-login.js"
    },
    {
      "source": "/api/database1/sync",
      "destination": "api/database1/sync.js"
    },
    {
      "source": "/api/database1/subscribe",
      "destination": "api/database1/subscribe.js"
    },
    {
      "source": "/api/database1/github-login",
      "destination": "api/database1/github-login.js"
    },
    {
      "source": "/api/database1/verify-otp",
      "destination": "api/database1/login.js"
    },
    {
      "source": "/api/auth/:action",
      "destination": "api/auth/flow.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
